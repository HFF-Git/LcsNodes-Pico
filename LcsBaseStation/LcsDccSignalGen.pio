//----------------------------------------------------------------------------------------
// DCC Signal Generator. I
//
// ??? it would be a great idea to let the DCC signals being produced bei a PIO state 
// machine. Right now, there is a timer wich interrupts teh CPU every signal edge change.
// Letting a PIO state machine process a DCC byte would be a great relief.
// 
//----------------------------------------------------------------------------------------
.program dcc_signal_gen

// ??? to do ... first sketch, not quite what i want ....
// PIO program to generate DCC signal timing
// Handles cutout, preamble, and bit encoding based on FIFO input
// ??? where do we put in power sense, request for more data...
// base clock cycle 29us

.wrap_target

// ??? when do we know that we need to do a cutput / preamble ?

cutout_phase:
    set pins, 0b01 [1]              ; 1 tick high
    set pins, 0b00 [14]             ; 14 ticks low
    set pins, 0b01 [1]              ; 1 tick high

preamble_start:
    set x, 15                       ; set counter, could also be set via program

preamble_loop:
    set pins, 0b01 [2]              ; 2 ticks high
    set pins, 0b10 [2]              ; 2 ticks low
    jmp x-- preamble_loop           ; are we done ?

main_loop:


    ; Main data loop
    ; should we rather ask for bytes than pack words ?
    ; we then handle variable sized DCC packets..
    ; we need to programatically set the x for the number of bytes, up to 15 
    ; we just tale a byte at a time to get it out. 
    ; then we go back to cutout / preambe. 
    ; this is also the time where we interrupt to get the next packet.
    ; and trigger any other follow up... such as power sense.

pull_next_word:
    pull block              ; Get 32 bits from FIFO
    mov isr, osr            ; Copy to input shift register
    set x, 3                ; Max 4 bytes per word // ??? what idf there are less ?

process_byte:
    in null, 24             ; Discard unused bits
    set y, 8                ; 8 bits in a byte

bit_send:
    out pins, 1             ; Output 1 bit
 //   jmp !pins zero_bit      ; If bit is 0, handle zero

    ; Handle a DCC '1' ( 2 high, 2 low)
    set pins, 0b01 [2]
    set pins, 0b10 [2]
    jmp continue_bit

zero_bit:
    ; Handle a DCC '0' (116 µs high, 116 µs low)
    set pins, 0b01 [4]
    set pins, 0b10 [4]

continue_bit:
    jmp y-- bit_send        ; Process next bit

    ; Append mandatory zero bit after each byte
    set pins, 0b01 [4]
    set pins, 0b10 [4]

    jmp x-- process_byte    ; Process next byte in the word

    ; Check if more words are available
    jmp pull_next_word      ; Loop back for next word

.wrap


//----------------------------------------------------------------------------------------
// C program code for PIO setup part.
//
//----------------------------------------------------------------------------------------
% c-sdk {

#include <stdio.h>
#include <stdint.h>
#include "hardware/clocks.h"
#include "hardware/gpio.h"

//----------------------------------------------------------------------------------------
// PIO program for DCC signal generation. 
//
//
//----------------------------------------------------------------------------------------
static inline void dcc_signal_gen( PIO pio, uint sm, uint pin_out ) {

    pio_gpio_init( pio, pin_out );
    pio_sm_set_consecutive_pindirs( pio, sm, pin_out, 2, true );

    pio_sm_config c = dcc_signal_gen_program_get_default_config( 0 );
    sm_config_set_out_pins( &c, pin_out, 2 );
    sm_config_set_clkdiv( &c, 1.0f );
    pio_sm_init( pio, sm, 0, &c );
    pio_sm_set_enabled( pio, sm, true );
}

%}