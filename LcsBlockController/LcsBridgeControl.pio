//------------------------------------------------------------------------------------------------------------
// Basic DCC Signal Handler. The block controller uses a small PIO program to control the H-Bridge when DCC 
// mode is enabled. The basic work of the PIO state machine is to relay the inverted DCC input from the Opto
// Couplers to the output pins which drive the select input of the H-Brigde chip. There are 4 pins this state 
// machine will use:
// 
//       DCC in          - 2 signal lines directly from the LCS bus DCC signal input. 
//       H-Bridge out    - 2 control lines for the H-Bridge: 00 -> short curcuit, 01, 10 -> on, 11 - Z state.
// 
// When the DCC input signal drops to 0b00, we either have no signal or the start of the Cutout period. We 
// insert a 4 microsecond delay, which gives some leeway when two boosters are not entirely in sync, although
// driven from the same DCC signal. After this blackout DCC input is relayed to the output. In addition, the
// start and end of the cutout period is signaled with the PIO state machine interrupt flags.
//
//------------------------------------------------------------------------------------------------------------
.program h_bridge_signal_control

main_loop:
    mov x, pins                 ; get DCC input
    mov pins, x                 ; Mirror to output
    jmp !x, blackout_start      ; if DCC input == 0b00, go to start blackout
    jmp main_loop               ; else just keep mirroring 

blackout_start:
    set pins, 0b11              ; Disable H-Bridge, 0b11 
    set y, 31                   ; prepare 4us loop

delay_loop:
    jmp y--, delay_loop         ; ~4µs delay
    set pins, 0                 ; Enter true blackout, 0b00

wait_rising:
    mov x, pins                 ; Read pins again
    jmp !x, wait_rising         ; Loop while still 0b00

    irq set 5                   ; Set IRQ flag on cutout end
    jmp main_loop               ; Return to main loop

//------------------------------------------------------------------------------------------------------------
// When in DCC mode, we need to deal with the cutout and potentially a railcom datagram. This PIO program will
// handle the cutout processing as well as the railcom datagram receive. There are 5 pins this machine will 
// use:
// 
//       DCC in          - 2 signal lines directly from the LCS bus DCC signal input. 
//       H-Bridge out    - 2 control lines for the H-Bridge: 00 -> short curcuit, 01, 10 -> on, 11 - Z state.
//       Uart in         - UART input from RailCom dectector. ( also configured as JumpPin )
//
// In normal mode, we read in the DCC signals and echo them to the H-Bridge control pins. When a 0b00 is 
// detected, we are at the start if a cutout period. First we place the brdige in a short high impedance mode
// as described in the basic DCC signal handler. Next we poll for a start condition on the UART input, or a 
// change in the DCC signal state. 
// 
// A Railcom datagram is a sequence of 2 bytes followed by 6 bytes. We set up a loop to read and place each
// byte in the Input FIFO. The state machine needs to be flexible to read in the characteres. First, There
// is a gap between the first 2 bytes and the remainder. The remainder itself can be up to 6 bytes, but also
// be shorter. We therefore conbine the detection of cutout end, i.e. the H-Bridge control signals change
// to a 0b01 or 0b10 level with the detection of a UART start bit. When there is no UART input, we will 
// thourgh this test combination ensure that we do not miss the cutout end, and we still can tolerate a 
// gap between the individual bytes to receive. 
//
// The Railcom Baudrate is 250 KHz. To accomodate, we run the state machine at about a 2Mhz clock. So, the 
// initial copy of DCC to output is  about 1 microsecond.
//
//------------------------------------------------------------------------------------------------------------
.program h_bridge_signal_control_and_railcom

main_loop:
    mov x, pins                 ; get DCC input
    mov pins, x                 ; Mirror to output
    jmp !x, blackout_start      ; if DCC input == 0b00, go to start blackout
    jmp main_loop               ; else just keep mirroring 

blackout_start:
    set pins, 0b11              ; Disable H-Beidge, 0b11 
    set y, 31                   ; prepare 4us loop

delay_loop:
    jmp y--, delay_loop         ; ~4µs delay
    set pins, 0                 ; Enter true blackout,  0b00

uart_poll:
    mov x, pins                 ; get DCC input 
    jmp pin uart_poll           ; if UART pin high, try again
    jmp !x, uart_start          ; if DCC input == 0b00, we are stil in cutout, read in the UART byte
    irq 6 rel                   ; otherwise inform that we are leaving
    jmp main_loop               ; back to main loop.

uart_start:
    set y, 7    [10]            ; set bit count, delay for 10 cycles.
    in null, 32                 ; Clear ISR

bit_loop:
    in pins, 1 [6]              ; scan data bit, move to input shift register, delay for 6 cycles
    jmp y--, bit_loop           ; get the next bit 
    jmp pin push_byte           ; got 8 bits, branch on stop condition ( pin should be high )
    irq 4 rel                   ; signal a frame error
    jmp wait_rising             ; frame error, go to wait for end of cutout period

push_byte:    
    push                        ; got the character, push into FIO
    jmp x--, uart_poll          ; get the next byte

wait_rising:
    mov x, pins                 ; Done reading the datagram, get the DCC input and
    jmp !x, wait_rising         ; wait for end of cutout period
    irq 5 rel                   ; Cutout end, interrupt
    jmp main_loop               ; back to start.

//------------------------------------------------------------------------------------------------------------
// Simple DCC Cutout Detect Handler. The block controller uses a small PIO program to detect the DCC cutout
// signal when not in DCC mode. It is just used to sync the PWM signals. We detect the start of a cutout and 
// every Nth time interrupt the CPU. We set Y from the C -code and need to set every time we served the 
// interrupt.
// 
//------------------------------------------------------------------------------------------------------------
.program cutout_detect

start: 
    mov x, pins             ; Copy input pins to X register
    jmp !x, blackout_start  ; both bit are zero, jmp to handler
    jmp start               ; else back to start

blackout_start:
    jmp !y, trigger_irq     ; If Y is zero, trigger IRQ
    jmp y--, wait_low       ; Decrement Y and return to start

trigger_irq: 
    irq 0                   ; inform the CPU

wait_low: 
    mov x, pins             ; Copy input pins to X register
    jmp !x, wait_low        ; wait while X is still 00
    jmp start               ; X change, back to start


//------------------------------------------------------------------------------------------------------------
// C program code for PIO setup part.
//
//------------------------------------------------------------------------------------------------------------
% c-sdk {

#include <stdio.h>
#include <stdint.h>
#include "hardware/clocks.h"
#include "hardware/gpio.h"

//------------------------------------------------------------------------------------------------------------
// PIO program for H-Bridge control in DCC mode. The PIO program does just the relay of the DCC signal 
// without RailCom datagram processing. Upon detecting the start of the cutout period, the H-bridge is placed
// for 4 microseconds into high impedance state before entering putting the bridge in cutout node. At the 
// end of the citput period, an interrupt is raised.
// 
//      Input pins:     GPIO 4 and 5    (DCC signal from optocoupler)
//      Output pins:    GPIO 18 and 19  (to H-bridge)
//
//------------------------------------------------------------------------------------------------------------
static inline void h_bridge_signal_control( PIO pio, uint sm, uint pin_in, uint pin_out ) {

    pio_gpio_init( pio, pin_in );
    pio_gpio_init( pio, pin_out );
    pio_sm_set_consecutive_pindirs( pio, sm, pin_out, 2, true );
    pio_sm_config c = h_bridge_signal_control_program_get_default_config( 0 );
    sm_config_set_in_pins( &c, pin_in );
    sm_config_set_out_pins( &c, pin_out, 2 );
    sm_config_set_clkdiv( &c, 1.0f );
    pio_sm_init( pio, sm, 0, &c );
    pio_sm_set_enabled( pio, sm, true );
}

//------------------------------------------------------------------------------------------------------------
// PIO program for  H-Bridge control in DCC mode with RailCom datagram processing. 
//
// - setup an 8 entry fifo.
// - interrupt  the CPU at the end of a datagram.
//
// ??? to do ....
//------------------------------------------------------------------------------------------------------------
static inline void h_bridge_signal_control_and_railcom( PIO pio, uint sm, uint offset, uint pin, uint baud ) {
    
    pio_sm_set_consecutive_pindirs( pio, sm, pin, 1, false );
    pio_gpio_init( pio, pin );
    gpio_pull_up( pin );

    pio_sm_config c = h_bridge_signal_control_and_railcom_program_get_default_config( offset );
    sm_config_set_in_pins( &c, pin ); // for WAIT, IN
    sm_config_set_jmp_pin( &c, pin ); // for JMP
    
    // Shift to right, autopush disabled
    sm_config_set_in_shift( &c, true, false, 32 );

    // Deeper FIFO as we're not doing any TX
    sm_config_set_fifo_join( &c, PIO_FIFO_JOIN_RX );
    
    // SM transmits 1 bit per 8 execution cycles.
    float div = (float) clock_get_hz( clk_sys ) / ( 8 * baud );
    sm_config_set_clkdiv( &c, div );

    pio_sm_init( pio, sm, offset, &c );
    pio_sm_set_enabled( pio, sm, true );
}

//------------------------------------------------------------------------------------------------------------
//
//
//------------------------------------------------------------------------------------------------------------
static inline void cutout_detect( PIO pio, uint sm, uint pin_in ) {

    pio_gpio_init( pio, pin_in );
    pio_sm_set_consecutive_pindirs( pio, sm, pin_in, 2, true );
    pio_sm_config c = cutout_detect_program_get_default_config( 0 );
    sm_config_set_in_pins( &c, pin_in );
    sm_config_set_clkdiv( &c, 1.0f );
    pio_sm_init( pio, sm, 0, &c );
    pio_sm_set_enabled( pio, sm, true );
}


%}


