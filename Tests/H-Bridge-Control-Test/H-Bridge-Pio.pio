;-------------------------------------------------------------------------------------------------------------
; DCC Signal Handler
;
;   - copies the DCC signal input pins to the H-Bridge output pins. 
;   - DCC signal input is inverted, invert it.
;   - when DCC == 0b00 start blackout period ( need to detect the 00 )
;   - keep copying input to putput until next zero transistion.
; 
; 
;
; NOTE !!!! the pull is not the right idea. We do not want to put constantly somthin into the FIFO.
; perhaps a way of modiyfing the first instruction with a "MOV X, <num>" is a better idea.
; - change the in, out to use pins directly....
;
;
; ---- REWORK...
;-------------------------------------------------------------------------------------------------------------
.program dcc_h_bridge_control

start:

    ; move from in to out, inverted.
    ; when in == 0b00 -> cutout start 
    ;
    in pins, 2                          ; Read 2-bit input
    out pins, 2                         ; Output = input values

    mov x, pins                         ; move to X register
    jmp x--, start                      ; If x (y) is NOT zero, jump to start, else continue

    set pins, 0                         ; Set outputs to 0b11 for 4 µs
    set x, 14                           ; Delay (~4 µs at 125 MHz)

delay_loop:

    jmp x--, delay_loop                 ; delay loop
    set pins, 0                         ; Delay done, set outputs to 0b00.

wait_for_non_zero:

    in pins, 2                          ; Read 2-bit input pins
    mov y, pins                         ; Store new input state in y register
    jmp y--, start                      ; If non-zero jump to start
    jmp wait_for_non_zero               ; else stay in the loop




;-------------------------------------------------------------------------------------------------------------
; RailCom Datagram Receiver
;
; - UART 250kBaud, 8 bits, no parity, one stop bit.
; - readi in up to 6 bytes, which form a datagram.
; - interrupt the CPU when datagram is received.
; - IN pin 0 and JMP pin are both mapped to the GPIO used as UART RX.
;
; - assembles all 6 bytes of the datagram packet
;
;
; 
;-------------------------------------------------------------------------------------------------------------
.program railcom_datagram_rx

start:
    wait 0 pin 0
    set x, 7    [10]

bitloop:

    ; Stall until start bit is asserted
    ; Preload bit counter, then delay until halfway through
    ; the first data bit (12 cycles incl wait, set).
    in pins, 1          ; Shift data bit into ISR
    jmp x-- bitloop [6] ; Loop 8 times, each loop iteration is 8 cycles
    jmp pin good_stop

    irq 4 rel
    wait 1 pin 0
    jmp start

good_stop:

    push
    ; Check stop bit (should be high)
    ; Either a framing error or a break. Set a sticky flag,
    ; and wait for line to return to idle state.
    ; Don't push data if we didn't see good framing.
    ; No delay before returning to start; a little slack is
    ; important in case the TX clock is slightly too fast.

    ; if no good data -> interrupt to discard the rail datagram
    ; if 6 bytes received correctly -> interrupt to move the datagra, someplace else



.program railcom_datagram_rx_new

start:
    wait 0 pin 0           ; Wait for start bit
    set x, 5    [10]      ; Expect 6 characters (0-5)

bitloop:
    set y, 7             ; 8 bits per character
    in null, 32         ; Clear ISR to prepare for new character

bit_read:
    in pins, 1          ; Shift data bit into ISR
    jmp y-- bit_read [6]

    ; Check stop bit
    wait 1 pin 0        ; Wait for stop bit
    jmp pin good_stop

    ; Error condition
    irq 5 rel           ; Fire IRQ 5 for error
    ; set isr, 0x1F     ; Set sticky error flag --- why? just give up the FIFO...
    push                ; Push the error code to the FIFO
    jmp start


good_stop:
    push                ; Push valid character to FIFO
    jmp x-- bitloop     ; Loop for the next character

    ; All characters received
    irq 4 rel           ; Fire IRQ 4 for completion
    jmp start           ; Restart

.wrap


; In the main C program, you can check the IRQ flags to see if the
; transmission is complete or if an error occurred.


;-------------------------------------------------------------------------------------------------------------
; C program code for PIO setup part.
;
;-------------------------------------------------------------------------------------------------------------
% c-sdk {

#include <stdio.h>
#include <stdint.h>
#include "hardware/clocks.h"
#include "hardware/gpio.h"

//------------------------------------------------------------------------------------------------------------
//
//
//
//------------------------------------------------------------------------------------------------------------
static inline void dcc_h_bridge_control_program_init(   PIO pio, 
                                                        uint sm, 
                                                        uint offset, 
                                                        uint out0, 
                                                        uint out1, 
                                                        uint in0, 
                                                        uint in1 ) {

    printf( "setupPio  dcc_h_bridge_control_program_init: offset: %d\n", offset );

    pio_sm_config c = pio_get_default_sm_config( );
    sm_config_set_out_pins( &c, out0, 2 );
    sm_config_set_in_pins( &c, in0 );
    sm_config_set_sideset_pins( &c, out0 );
    sm_config_set_clkdiv( &c, 1.0 );
    sm_config_set_fifo_join( &c, PIO_FIFO_JOIN_RX );
    sm_config_set_wrap( &c, offset, offset + 23 );

    pio_gpio_init( pio, out0 );
    pio_gpio_init( pio, out1 );
    pio_gpio_init( pio, in0 );
    pio_gpio_init( pio, in1 );
    
    gpio_set_dir( out0, true );
    gpio_set_dir( out1, true );
    gpio_set_dir( in0, false );
    gpio_set_dir( in1, false );

    pio_sm_init( pio, sm, offset, &c );
    pio_sm_set_enabled( pio, sm, true );
}

//------------------------------------------------------------------------------------------------------------
//
// - setup an 8 entry fifo.
// - interrupt  the CPU at the end of a datagram.
//
//------------------------------------------------------------------------------------------------------------
static inline void railcom_datagram_rx_program_init( PIO pio, uint sm, uint offset, uint pin, uint baud ) {
    
    pio_sm_set_consecutive_pindirs( pio, sm, pin, 1, false );
    pio_gpio_init( pio, pin );
    gpio_pull_up( pin );

    // pio_sm_config c = pio_get_default_sm_config( );
    pio_sm_config c = railcom_datagram_rx_program_get_default_config( offset ); // ????? where does it come from ?
    sm_config_set_in_pins( &c, pin ); // for WAIT, IN
    sm_config_set_jmp_pin( &c, pin ); // for JMP
    
    // Shift to right, autopush disabled
    sm_config_set_in_shift( &c, true, false, 32 );

    // Deeper FIFO as we're not doing any TX
    sm_config_set_fifo_join( &c, PIO_FIFO_JOIN_RX );
    
    // SM transmits 1 bit per 8 execution cycles.
    float div = (float) clock_get_hz( clk_sys ) / ( 8 * baud );
    sm_config_set_clkdiv( &c, div );

    pio_sm_init( pio, sm, offset, &c );
    pio_sm_set_enabled( pio, sm, true );
 }




